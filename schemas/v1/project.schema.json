{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local-kanban.dev/schemas/v1/project.schema.json",
  "title": "Local Kanban registered project v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "rootPath", "docsPath"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "rootPath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "docsPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
