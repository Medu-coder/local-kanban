{
  "name": "local-kanban",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "local-kanban": "bin/local-kanban.js"
  },
  "scripts": {
    "setup": "node scripts/setup.js && node scripts/manage-skill.js install",
    "setup:reset": "node scripts/setup.js --force && node scripts/manage-skill.js install",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "npm run build && pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop ecosystem.config.cjs",
    "restart": "pm2 restart ecosystem.config.cjs",
    "status": "pm2 status",
    "logs": "pm2 logs",
    "local-kanban": "node bin/local-kanban.js",
    "skill:install": "node scripts/manage-skill.js install",
    "skill:verify": "node scripts/manage-skill.js verify",
    "check": "node scripts/check-static.js",
    "test:unit": "node --test test/*.test.js",
    "test:quality": "node --test test/diagnostics.test.js test/evals.test.js",
    "test:skill": "node --test test/skill-management.test.js",
    "eval": "node scripts/eval-agent-flow.js",
    "benchmark": "node scripts/benchmark.js",
    "release:verify": "npm run check && npm run test:unit && npm run test:quality && npm run eval && npm run benchmark && npm run build && npm run test:e2e && npm run skill:verify -- --local",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.2",
    "pm2": "^7.0.3",
    "vite": "^8.1.4"
  }
}
